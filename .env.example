# ====================================================================
# Wi-Fi Attendance System - Environment Configuration
# Copy this file to .env and fill in your values.
# ====================================================================

# Flask Security Key (change this in production!)
SECRET_KEY=wifi-attendance-secret-key-super-secure-2026

# SQLite database path
DATABASE_PATH=attendance.db

# ====================================================================
# DEVICE TOKEN & NETWORK VERIFICATION SETTINGS
# ====================================================================

# Comma-separated CIDR subnets of authorized campus Wi-Fi networks
# Students must be on these IPs to mark attendance.
AUTHORIZED_SUBNETS=192.168.1.0/24, 192.168.29.0/24

# Allow 127.0.0.1 (localhost) for development/testing (1=yes, 0=no)
ALLOW_LOCALHOST=1

# ====================================================================
# DAILY ATTENDANCE TIME WINDOWS (24-hour HH:MM)
# ====================================================================

# Window opens (students can start checking in after this time)
CHECKIN_START_TIME=08:00

# On-time cutoff: check-ins before this time → "Present"
CHECKIN_CUTOFF_TIME=09:30

# Late grace window cutoff: check-ins between cutoff and this time → "Late"
# After this time: check-in portal is CLOSED for the day
CHECKIN_LATE_CUTOFF=10:30

# ====================================================================
# LEGACY ARP SCANNER ENGINE (optional, can run alongside token mode)
# ====================================================================

SUBNET_RANGE=192.168.1.0/24
SCAN_INTERVAL=60

# ====================================================================
# ADMIN CREDENTIALS (change these on first run!)
# ====================================================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
